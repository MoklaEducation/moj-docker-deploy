# Local-only Keycloak test database settings.
# Copy this to environment/keycloak.test.env and replace placeholder values.

# Local-only Keycloak database settings.
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=3306
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_ROOT_PASSWORD=change-me-root

# Local-only Keycloak admin settings.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Local-only Keycloak test user settings.
KEYCLOAK_TEST_USER=dmoj-test
KEYCLOAK_TEST_USER_PASSWORD=change-me-test-user
KEYCLOAK_TEST_USER_EMAIL="dmoj-test@test.local"
KEYCLOAK_TEST_USER_FIRST_NAME="DMOJ"
KEYCLOAK_TEST_USER_LAST_NAME="Test User"

# DMOJ web Keycloak OIDC settings.
KEYCLOAK_OIDC_ENABLED=1
KEYCLOAK_OIDC_CLIENT_ID=dmoj-web
KEYCLOAK_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
KEYCLOAK_OIDC_ENDPOINT=https://auth.test.local/realms/dmoj-test
