#!/usr/bin/env bash
set -euo pipefail

PROJECT_NAME="${PROJECT_NAME:-dmoj-test}"
ENV_FILE="${ENV_FILE:-.env.test}"
SEED_DUMP="${SEED_DUMP:-seeds/latest.sql.gz}"
RESET_DB_ON_IMPORT="${RESET_DB_ON_IMPORT:-0}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE"
  exit 1
fi

if [[ ! -f "$SEED_DUMP" ]]; then
  echo "Missing seed dump: $SEED_DUMP"
  exit 1
fi

COMPOSE=(docker compose --env-file "$ENV_FILE" -f docker-compose.yml -f docker-compose.test.yml -p "$PROJECT_NAME")

# Ensure DB container is available before import.
"${COMPOSE[@]}" up -d db

if [[ "$RESET_DB_ON_IMPORT" == "1" ]]; then
  "${COMPOSE[@]}" exec -T db sh -lc 'mariadb -u root -p"$MYSQL_ROOT_PASSWORD" -e "DROP DATABASE IF EXISTS $MYSQL_DATABASE; CREATE DATABASE $MYSQL_DATABASE CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"'
fi

gzip -dc "$SEED_DUMP" | "${COMPOSE[@]}" exec -T db sh -lc 'mariadb -u root -p"$MYSQL_ROOT_PASSWORD" "$MYSQL_DATABASE"'

echo "Seed import completed from: $SEED_DUMP"
