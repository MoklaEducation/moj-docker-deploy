#!/usr/bin/env bash
# Source this file to enable dct commands in the current shell.
# Usage:
#   source /path/to/moj-docker-deploy/dmoj/scripts/teststack/dct/dct-init

# Intentionally do not set strict shell options here because this file is sourced.
# Changing shell options in a sourced script can unexpectedly terminate the user's shell.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../../" && pwd)"
DMOJ_DIR="$(cd "$SCRIPT_DIR/../../../" && pwd)"

case ":${PATH}:" in
  *":${SCRIPT_DIR}:"*) ;;
  *) export PATH="${SCRIPT_DIR}:${PATH}" ;;
esac

export DCT_REPO_ROOT="$REPO_ROOT"
export DCT_DMOJ_DIR="$DMOJ_DIR"

cat <<EOF
DCT initialized for this shell.
- dct path: ${SCRIPT_DIR}/dct
- dct-bootstrap path: ${SCRIPT_DIR}/dct-bootstrap
- repo root: ${REPO_ROOT}
- dmoj dir: ${DMOJ_DIR}

You can now run from anywhere:
  dct ps
  dct up -d
  dct-bootstrap
EOF
