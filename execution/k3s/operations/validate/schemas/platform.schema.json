{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mokla.example/schemas/platform.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment_name", "target_connection", "host_fqdn", "host_address", "network", "host", "docker", "data_services", "external_platform_services", "backup", "k3s", "cluster_core", "cluster_addons"],
  "properties": {
    "environment_name": {"type": "string", "minLength": 1},
    "target_connection": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"type": "string", "enum": ["local", "ssh"]}}
    },
    "host_fqdn": {"type": "string", "minLength": 1},
    "host_address": {"type": "string", "format": "ipv4"},
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["administrative_cidrs", "public_ingress_ports", "pod_cidr", "service_cidr", "dns_names", "outbound_https_endpoints"],
      "properties": {
        "administrative_cidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "public_ingress_ports": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "pod_cidr": {"type": "string"}, "service_cidr": {"type": "string"},
        "additional_cidrs": {"type": "array", "items": {"type": "string"}},
        "dns_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "outbound_https_endpoints": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["os_distribution", "os_versions", "storage_root", "config_root", "state_root", "evidence_root", "minimum_cpu", "minimum_memory_mb", "minimum_root_free_gb", "minimum_free_disk_percent", "timezone", "automation_user", "ssh_port", "disable_swap", "allow_automatic_security_updates", "allow_automatic_reboot", "journald_max_use"],
      "properties": {
        "os_distribution": {"const": "Ubuntu"},
        "os_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "storage_root": {"$ref": "#/$defs/absolute_path"},
        "config_root": {"$ref": "#/$defs/absolute_path"},
        "state_root": {"$ref": "#/$defs/absolute_path"},
        "evidence_root": {"$ref": "#/$defs/absolute_path"},
        "minimum_cpu": {"type": "integer", "minimum": 1},
        "minimum_memory_mb": {"type": "integer", "minimum": 1},
        "minimum_root_free_gb": {"type": "number", "exclusiveMinimum": 0},
        "minimum_free_disk_percent": {"type": "integer", "minimum": 1, "maximum": 99},
        "timezone": {"type": "string", "minLength": 1},
        "automation_user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]*$"},
        "ssh_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "disable_swap": {"type": "boolean"},
        "allow_automatic_security_updates": {"type": "boolean"},
        "allow_automatic_reboot": {"const": false},
        "journald_max_use": {"type": "string", "pattern": "^[1-9][0-9]*[KMG]$"}
      }
    },
    "docker": {
      "type": "object", "additionalProperties": false,
      "required": ["apt_repository", "repository_key_fingerprint", "engine_version", "compose_plugin_version", "data_root", "log_max_size", "log_max_files"],
      "properties": {
        "apt_repository": {"const": "https://download.docker.com/linux/ubuntu"},
        "repository_key_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
        "engine_version": {"type": "string", "minLength": 1, "not": {"pattern": "^REPLACE_"}},
        "compose_plugin_version": {"type": "string", "minLength": 1, "not": {"pattern": "^REPLACE_"}},
        "data_root": {"$ref": "#/$defs/absolute_path"},
        "log_max_size": {"type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]$"},
        "log_max_files": {"type": "integer", "minimum": 1}
      }
    },
    "data_services": {
      "type": "object", "additionalProperties": false,
      "required": ["delivery_profile", "provisioning_mode", "systemd_supervision_enabled", "bind_address", "allowed_client_cidrs", "tls", "mariadb", "redis"],
      "properties": {
        "delivery_profile": {"type": "string", "enum": ["development", "hardened"]},
        "provisioning_mode": {"type": "string", "enum": ["helper-managed", "external"]},
        "systemd_supervision_enabled": {"type": "boolean"},
        "bind_address": {"type": "string", "format": "ipv4"},
        "allowed_client_cidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "tls": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minimum_version": {"type": "string", "enum": ["TLSv1.2", "TLSv1.3"]},
            "server_certificate_secret_key": {"type": "string", "minLength": 1},
            "server_private_key_secret_key": {"type": "string", "minLength": 1},
            "ca_certificate_secret_key": {"type": "string", "minLength": 1},
            "renewal_owner": {"type": "string", "minLength": 1}
          },
          "allOf": [{
            "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
            "then": {"required": ["minimum_version", "server_certificate_secret_key", "server_private_key_secret_key", "ca_certificate_secret_key", "renewal_owner"]}
          }]
        },
        "mariadb": {
          "type": "object", "additionalProperties": false,
          "required": ["image", "compatibility_rationale", "image_scan", "port", "runtime_uid", "runtime_gid", "probe_username", "probe_password_secret_key", "character_set", "collation", "data_path", "config_path", "backup_timeout_seconds", "health_timeout_seconds", "memory_limit", "cpus"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "compatibility_rationale": {"type": "string", "minLength": 1},
            "image_scan": {"$ref": "#/$defs/image_scan"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "runtime_uid": {"type": "integer", "minimum": 1},
            "runtime_gid": {"type": "integer", "minimum": 1},
            "probe_username": {"type": "string", "minLength": 1},
            "probe_password_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "character_set": {"type": "string", "minLength": 1},
            "collation": {"type": "string", "minLength": 1},
            "data_path": {"$ref": "#/$defs/absolute_path"},
            "config_path": {"$ref": "#/$defs/absolute_path"},
            "backup_timeout_seconds": {"type": "integer", "minimum": 1},
            "health_timeout_seconds": {"type": "integer", "minimum": 1},
            "memory_limit": {"$ref": "#/$defs/memory_size"},
            "cpus": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "redis": {
          "type": "object", "additionalProperties": false,
          "required": ["image", "compatibility_rationale", "image_scan", "port", "runtime_uid", "runtime_gid", "probe_username", "probe_password_secret_key", "authentication_enabled", "data_policy", "data_path", "config_path", "maxmemory", "maxmemory_policy", "health_timeout_seconds", "memory_limit", "cpus"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "compatibility_rationale": {"type": "string", "minLength": 1},
            "image_scan": {"$ref": "#/$defs/image_scan"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "runtime_uid": {"type": "integer", "minimum": 1},
            "runtime_gid": {"type": "integer", "minimum": 1},
            "probe_username": {"type": "string", "minLength": 1},
            "probe_password_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "authentication_enabled": {"type": "boolean"},
            "data_policy": {"type": "string", "enum": ["persistent", "disposable"]},
            "data_path": {"$ref": "#/$defs/absolute_path"},
            "config_path": {"$ref": "#/$defs/absolute_path"},
            "maxmemory": {"type": "integer", "minimum": 1},
            "maxmemory_policy": {"type": "string", "enum": ["noeviction", "allkeys-lru", "allkeys-lfu", "allkeys-random", "volatile-lru", "volatile-lfu", "volatile-random", "volatile-ttl"]},
            "health_timeout_seconds": {"type": "integer", "minimum": 1},
            "memory_limit": {"$ref": "#/$defs/memory_size"},
            "cpus": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "external_platform_services": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "provisioning_mode", "bind_address", "allowed_client_cidrs", "object_storage", "alert_receiver"],
      "properties": {
        "profile": {"type": "string", "enum": ["co-located-development", "isolated-test", "recovery-qualified"]},
        "provisioning_mode": {"type": "string", "enum": ["helper-managed", "external"]},
        "bind_address": {"type": "string", "format": "ipv4"},
        "allowed_client_cidrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "object_storage": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "distribution_status", "image", "compatibility_rationale", "image_scan", "api_port", "console_port", "runtime_uid", "runtime_gid", "bucket", "data_path", "root_user_secret_key", "root_password_secret_key", "restic_access_key_secret_key", "restic_secret_key_secret_key", "health_timeout_seconds", "memory_limit", "cpus"],
          "properties": {
            "provider": {"const": "minio"},
            "distribution_status": {"const": "frozen-legacy-test-only"},
            "image": {"type": "string", "minLength": 1},
            "compatibility_rationale": {"type": "string", "minLength": 1},
            "image_scan": {"$ref": "#/$defs/image_scan"},
            "api_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "console_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "runtime_uid": {"type": "integer", "minimum": 1},
            "runtime_gid": {"type": "integer", "minimum": 0},
            "bucket": {"type": "string", "minLength": 3, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
            "data_path": {"$ref": "#/$defs/absolute_path"},
            "root_user_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "root_password_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "restic_access_key_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "restic_secret_key_secret_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "health_timeout_seconds": {"type": "integer", "minimum": 1},
            "memory_limit": {"$ref": "#/$defs/memory_size"},
            "cpus": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "alert_receiver": {
          "type": "object", "additionalProperties": false,
          "required": ["image", "compatibility_rationale", "image_scan", "port", "runtime_uid", "runtime_gid", "endpoint", "data_policy", "max_events", "health_timeout_seconds", "memory_limit", "cpus"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "compatibility_rationale": {"type": "string", "minLength": 1},
            "image_scan": {"$ref": "#/$defs/image_scan"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "runtime_uid": {"type": "integer", "minimum": 1},
            "runtime_gid": {"type": "integer", "minimum": 1},
            "endpoint": {"type": "string", "pattern": "^http://[^/?#]+:[0-9]+/alerts$"},
            "data_policy": {"const": "disposable"},
            "max_events": {"type": "integer", "minimum": 1, "maximum": 1000},
            "health_timeout_seconds": {"type": "integer", "minimum": 1},
            "memory_limit": {"$ref": "#/$defs/memory_size"},
            "cpus": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "backup": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "repository_mode": {"type": "string", "enum": ["off-host", "local-development"]},
        "local_repository_risk_accepted": {"type": "boolean"},
        "restic_repository": {"type": "string", "minLength": 1},
        "repository_credential_secret_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "staging_path": {"$ref": "#/$defs/absolute_path"},
        "schedule": {"type": "string", "minLength": 1},
        "randomized_delay_seconds": {"type": "integer", "minimum": 0},
        "retention": {
          "type": "object", "additionalProperties": false,
          "required": ["daily", "weekly", "monthly"],
          "properties": {
            "daily": {"type": "integer", "minimum": 1},
            "weekly": {"type": "integer", "minimum": 1},
            "monthly": {"type": "integer", "minimum": 1}
          }
        },
        "minimum_expected_frequency_hours": {"type": "integer", "minimum": 1},
        "minimum_free_space_mb": {"type": "integer", "minimum": 1},
        "restore": {
          "type": "object", "additionalProperties": false,
          "required": ["target_root", "bind_address", "mariadb_port", "redis_port"],
          "properties": {
            "target_root": {"$ref": "#/$defs/absolute_path"},
            "bind_address": {"type": "string", "format": "ipv4"},
            "mariadb_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "redis_port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
        "then": {"required": ["repository_mode", "local_repository_risk_accepted", "restic_repository", "repository_credential_secret_keys", "staging_path", "schedule", "randomized_delay_seconds", "retention", "minimum_expected_frequency_hours", "minimum_free_space_mb", "restore"]}
      }]
    },
    "k3s": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum", "node_name", "node_ip", "api_bind_address", "tls_sans", "cluster_cidr", "service_cidr", "cluster_dns", "data_dir", "local_storage_path", "kubeconfig_output", "secrets_encryption"],
      "properties": {
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$"},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "node_name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
        "node_ip": {"type": "string", "format": "ipv4"},
        "api_bind_address": {"type": "string", "format": "ipv4"},
        "tls_sans": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cluster_cidr": {"type": "string", "minLength": 1},
        "service_cidr": {"type": "string", "minLength": 1},
        "cluster_dns": {"type": "string", "format": "ipv4"},
        "data_dir": {"$ref": "#/$defs/absolute_path"},
        "local_storage_path": {"$ref": "#/$defs/absolute_path"},
        "kubeconfig_output": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "secrets_encryption": {"const": true}
      }
    },
    "cluster_core": {
      "type": "object", "additionalProperties": false,
      "required": ["managed_by", "application_umbrella", "namespaces", "pod_security", "identities", "quotas", "limits", "network", "storage", "secret_delivery", "smoke_image"],
      "properties": {
        "managed_by": {"const": "mokla-cluster-core"},
        "application_umbrella": {"const": "judge-platform"},
        "namespaces": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "observability", "backup", "application", "reserved"],
          "properties": {
            "platform": {"const": "platform-system"},
            "observability": {"const": "observability"},
            "backup": {"const": "backup-system"},
            "application": {"type": "string", "pattern": "^judge-(?:test|prod|staging)$"},
            "reserved": {
              "type": "array", "uniqueItems": true,
              "items": {"type": "string", "pattern": "^judge-(?:test|prod|staging)$"}
            }
          }
        },
        "pod_security": {
          "type": "object", "additionalProperties": false,
          "required": ["enforce", "audit", "warn", "version"],
          "properties": {
            "enforce": {"const": "restricted"},
            "audit": {"const": "restricted"},
            "warn": {"const": "restricted"},
            "version": {"type": "string", "pattern": "^(?:latest|v[0-9]+\\.[0-9]+)$"}
          }
        },
        "identities": {
          "type": "object", "additionalProperties": false,
          "required": ["operator", "automation"],
          "properties": {
            "operator": {"$ref": "#/$defs/cluster_identity"},
            "automation": {"$ref": "#/$defs/cluster_identity"}
          }
        },
        "quotas": {
          "type": "object", "additionalProperties": false,
          "required": ["platform", "observability", "backup", "application"],
          "properties": {
            "platform": {"$ref": "#/$defs/namespace_quota"},
            "observability": {"$ref": "#/$defs/namespace_quota"},
            "backup": {"$ref": "#/$defs/namespace_quota"},
            "application": {"$ref": "#/$defs/namespace_quota"}
          }
        },
        "limits": {"$ref": "#/$defs/container_limits"},
        "network": {
          "type": "object", "additionalProperties": false,
          "required": ["dns_namespace", "dns_pod_label", "allow_application_data_services"],
          "properties": {
            "dns_namespace": {"const": "kube-system"},
            "dns_pod_label": {"const": "k8s-app=kube-dns"},
            "allow_application_data_services": {"type": "boolean"}
          }
        },
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["class_name", "remain_default", "allowed_namespaces"],
          "properties": {
            "class_name": {"const": "local-path"},
            "remain_default": {"type": "boolean"},
            "allowed_namespaces": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "secret_delivery": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "age_recipient", "identity_environment_variable"],
          "properties": {
            "provider": {"const": "sops-age"},
            "age_recipient": {"type": "string", "pattern": "^age1[0-9a-z]+$"},
            "identity_environment_variable": {"const": "SOPS_AGE_KEY_FILE"}
          }
        },
        "smoke_image": {"type": "string", "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"}
      }
    },
    "cluster_addons": {
      "type": "object", "additionalProperties": false,
      "required": ["managed_by", "profile", "identity", "namespaces", "private_access", "capabilities", "certificates", "metrics", "logs"],
      "properties": {
        "managed_by": {"const": "mokla-cluster-addons"},
        "profile": {"const": "private-test"},
        "identity": {"$ref": "#/$defs/cluster_identity"},
        "namespaces": {
          "type": "object", "additionalProperties": false,
          "required": ["certificates", "node_agents"],
          "properties": {
            "certificates": {"const": "cert-manager"},
            "node_agents": {"const": "observability-agents"}
          }
        },
        "private_access": {
          "type": "object", "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "port-forward"}}
        },
        "capabilities": {
          "type": "object", "additionalProperties": false,
          "required": ["certificates", "metrics", "logs", "backups"],
          "properties": {
            "certificates": {"const": true},
            "metrics": {"type": "boolean"},
            "logs": {"type": "boolean"},
            "backups": {"const": false}
          }
        },
        "certificates": {
          "type": "object", "additionalProperties": false,
          "required": ["issuer_name", "hostname", "duration", "renew_before", "ingress_class"],
          "properties": {
            "issuer_name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            "hostname": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"},
            "duration": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
            "renew_before": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
            "ingress_class": {"const": "traefik"}
          }
        },
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["retention", "scrape_interval", "evaluation_interval", "prometheus_storage", "alertmanager_storage", "grafana_storage", "alert_receiver_endpoint"],
          "properties": {
            "retention": {"type": "string", "pattern": "^[1-9][0-9]*[dh]$"},
            "scrape_interval": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "evaluation_interval": {"type": "string", "pattern": "^[1-9][0-9]*s$"},
            "prometheus_storage": {"$ref": "#/$defs/memory_size"},
            "alertmanager_storage": {"$ref": "#/$defs/memory_size"},
            "grafana_storage": {"$ref": "#/$defs/memory_size"},
            "alert_receiver_endpoint": {"type": "string", "pattern": "^http://(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:[1-9][0-9]{0,4}/alerts$"}
          }
        },
        "logs": {
          "type": "object", "additionalProperties": false,
          "required": ["retention", "storage", "ingestion_rate_mb", "ingestion_burst_mb", "max_query_parallelism", "namespaces", "redaction_policy"],
          "properties": {
            "retention": {"type": "string", "pattern": "^[1-9][0-9]*[dh]$"},
            "storage": {"$ref": "#/$defs/memory_size"},
            "ingestion_rate_mb": {"type": "integer", "minimum": 1, "maximum": 16},
            "ingestion_burst_mb": {"type": "integer", "minimum": 1, "maximum": 32},
            "max_query_parallelism": {"type": "integer", "minimum": 1, "maximum": 16},
            "namespaces": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"}
            },
            "redaction_policy": {"const": "phase6-sensitive-v1"}
          }
        }
      }
    }
  },
  "$defs": {
    "absolute_path": {"type": "string", "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "image_scan": {
      "type": "object", "additionalProperties": false,
      "required": ["scanner", "scanned_at", "findings", "approved_by"],
      "properties": {
        "scanner": {"type": "string", "minLength": 1},
        "scanned_at": {"type": "string", "format": "date"},
        "findings": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1}
      }
    },
    "memory_size": {"type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]$"}
    ,
    "cluster_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "group", "kubeconfig_output", "certificate_validity_days"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "group": {"type": "string", "pattern": "^[a-z][a-z0-9:-]*$"},
        "kubeconfig_output": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "certificate_validity_days": {"type": "integer", "minimum": 1, "maximum": 90}
      }
    },
    "namespace_quota": {
      "type": "object", "additionalProperties": false,
      "required": ["requests_cpu", "requests_memory", "limits_cpu", "limits_memory", "pods", "persistentvolumeclaims", "requests_storage"],
      "properties": {
        "requests_cpu": {"$ref": "#/$defs/cpu_quantity"},
        "requests_memory": {"$ref": "#/$defs/memory_size"},
        "limits_cpu": {"$ref": "#/$defs/cpu_quantity"},
        "limits_memory": {"$ref": "#/$defs/memory_size"},
        "pods": {"type": "integer", "minimum": 1},
        "persistentvolumeclaims": {"type": "integer", "minimum": 0},
        "requests_storage": {"$ref": "#/$defs/memory_size"}
      }
    },
    "container_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["default_request_cpu", "default_request_memory", "default_cpu", "default_memory"],
      "properties": {
        "default_request_cpu": {"$ref": "#/$defs/cpu_quantity"},
        "default_request_memory": {"$ref": "#/$defs/memory_size"},
        "default_cpu": {"$ref": "#/$defs/cpu_quantity"},
        "default_memory": {"$ref": "#/$defs/memory_size"}
      }
    },
    "cpu_quantity": {"type": "string", "pattern": "^(?:[1-9][0-9]*m|[1-9][0-9]*(?:\\.[0-9]+)?)$"}
  }
}