[mariadb]
bind-address = {{ data_services.bind_address }}
port = {{ data_services.mariadb.port }}
character-set-server = {{ data_services.mariadb.character_set }}
collation-server = {{ data_services.mariadb.collation }}
{% if data_services.tls.enabled %}
require_secure_transport = ON
tls_version = {{ data_services.tls.minimum_version }}
ssl-ca = /run/secrets/ca.crt
ssl-cert = /run/secrets/server.crt
ssl-key = /run/secrets/server.key
{% else %}
require_secure_transport = OFF
{% endif %}
innodb_flush_log_at_trx_commit = 1
sync_binlog = 1
skip-name-resolve
log_error = /proc/self/fd/2