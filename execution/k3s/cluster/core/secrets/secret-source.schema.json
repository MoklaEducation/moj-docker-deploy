{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "type", "stringData"],
  "properties": {
    "apiVersion": {"const": "v1"},
    "kind": {"const": "Secret"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
        "namespace": {"type": "string", "pattern": "^judge-(?:test|prod|staging)$"}
      }
    },
    "type": {"const": "Opaque"},
    "stringData": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}